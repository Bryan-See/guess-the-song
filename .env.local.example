# ===========================================
# SPOTIFY CREDENTIALS
# Get from: https://developer.spotify.com/dashboard
# ===========================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ===========================================
# NEXTAUTH CONFIG (don't change these)
# ===========================================
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand_base64_32

# ===========================================
# SPOTIFY REDIRECT (must match dashboard)
# ===========================================
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/spotify
